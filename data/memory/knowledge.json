# ================================
# JARVIS Memory Engine Bootstrap
# ================================

# Create folders
New-Item -ItemType Directory -Force -Path "app\memory" | Out-Null
New-Item -ItemType Directory -Force -Path "data\memory" | Out-Null

# Python modules
$modules = @(
    "__init__.py",
    "manager.py",
    "storage.py",
    "session.py",
    "history.py",
    "projects.py",
    "preferences.py",
    "knowledge.py",
    "search.py",
    "context.py",
    "models.py"
)

foreach ($module in $modules) {
    $path = Join-Path "app\memory" $module

    if (!(Test-Path $path)) {
        @"
\"\"\"
JARVIS Memory Engine
File: $module
Version: 0.6.0
\"\"\"
"@ | Set-Content $path
    }
}

# JSON databases
$databases = @(
    "history.json",
    "session.json",
    "projects.json",
    "preferences.json",
    "knowledge.json"
)

foreach ($db in $databases) {
    $path = Join-Path "data\memory" $db

    if (!(Test-Path $path)) {
        "{}" | Set-Content $path
    }
}

Write-Host ""
Write-Host "===================================" -ForegroundColor Green
Write-Host " JARVIS Memory Engine Initialized" -ForegroundColor Green
Write-Host "===================================" -ForegroundColor Green
Write-Host ""
Write-Host "Created:"
Write-Host " app\memory"
Write-Host " data\memory"
Write-Host ""
Write-Host "Memory Modules:"
Get-ChildItem app\memory

Write-Host ""
Write-Host "Memory Databases:"
Get-ChildItem data\memory